---
interface Props {
  number: string;
  cover: string;
  coverSmall: string;
  eager?: boolean;
}
const { number, cover, coverSmall, eager = false } = Astro.props;
---

<div class="cover cover-image">
  <img
    src={cover}
    srcset={`${coverSmall} 360w, ${cover} 720w`}
    sizes="(max-width:480px) 44vw, (max-width:760px) 30vw, 230px"
    width="720"
    height="1080"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    alt={`Sampul Oregairu Volume ${number}`}
  />
</div>
