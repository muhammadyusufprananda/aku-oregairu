right.xhtml#30"}, {"id": "en-copyright-31", "kind": "text", "text": "ISBN: 978-1-975-35980-5", "source": "OEBPS/Text/copyright.xhtml#31"}, {"id": "en-copyright-32", "kind": "text", "text": "E3-20190611-JV-NF-ORI", "source": "OEBPS/Text/copyright.xhtml#32"}, {"id": "en-toc-0", "kind": "heading", "text": "Contents", "source": "OEBPS/Text/toc.xhtml#0", "headingLevel": 2}, {"id": "en-toc-1", "kind": "text", "text": "Cover", "source": "OEBPS/Text/toc.xhtml#1"}, {"id": "en-toc-2", "kind": "text", "text": "Insert", "source": "OEBPS/Text/toc.xhtml#2"}, {"id": "en-toc-3", "kind": "text", "text": "Title Page", "source": "OEBPS/Text/toc.xhtml#3"}, {"id": "en-toc-4", "kind": "text", "text": "Copyright", "source": "OEBPS/Text/toc.xhtml#4"}, {"id": "en-toc-5", "kind": "text", "text": "Cast of Characters", "source": "OEBPS/Text/toc.xhtml#5"}, {"id": "en-toc-6", "kind": "text", "text": "1 Anyway, Hachiman Hikigaya is rotten.", "source": "OEBPS/Text/toc.xhtml#6", "emphasis": [{"start": 10, "end": 27, "style": "strong"}]}, {"id": "en-toc-7", "kind": "text", "text": "2 Yukino Yukinoshita always stands firm.", "source": "OEBPS/Text/toc.xhtml#7", "emphasis": [{"start": 2, "end": 20, "style": "strong"}]}, {"id": "en-toc-8", "kind": "text", "text": "3 Yui Yuigahama is perpetually glancing around furtively.", "source": "OEBPS/Text/toc.xhtml#8", "emphasis": [{"start": 2, "end": 15, "style": "strong"}]}, {"id": "en-toc-9", "kind": "text", "text": "4 Even so, the class is doing well.", "source": "OEBPS/Text/toc.xhtml#9", "emphasis": [{"start": 11, "end": 20, "style": "strong"}]}, {"id": "en-toc-10", "kind": "text", "text": "5 In other words, Yoshiteru Zaimokuza is rather off.", "source": "OEBPS/Text/toc.xhtml#10", "emphasis": [{"start": 18, "end": 37, "style": "strong"}]}, {"id": "en-toc-11", "kind": "text", "text": "6 But Saika Totsuka has one.", "source": "OEBPS/Text/toc.xhtml#11", "emphasis": [{"start": 6, "end": 19, "style": "strong"}]}, {"id": "en-toc-12", "kind": "text", "text": "7 Sometimes, the gods of romantic comedy are kind.", "source": "OEBPS/Text/toc.xhtml#12", "emphasis": [{"start": 13, "end": 40, "style": "strong"}]}, {"id": "en-toc-13", "kind": "text", "text": "8 And then Hikigaya ponders.", "source": "OEBPS/Text/toc.xhtml#13", "emphasis": [{"start": 11, "end": 19, "style": "strong"}]}, {"id": "en-toc-14", "kind": "text", "text": "Afterword", "source": "OEBPS/Text/toc.xhtml#14"}, {"id": "en-toc-15", "kind": "text", "text": "Translation Notes", "source": "OEBPS/Text/toc.xhtml#15"}, {"id": "en-toc-16", "kind": "text", "text": "Yen Newsletter", "source": "OEBPS/Text/toc.xhtml#16"}, {"id": "en-preface001-0", "kind": "image", "text": "Book Title Page", "source": "OEBPS/Text/preface001.xhtml#../Images/Art_P1.jpg", "src": "assets/english/volume-1/Art_P1.webp", "width": 1200, "height": 1800}, {"id": "en-preface002-0", "kind": "image", "text": "Book Title Page", "source": "OEBPS/Text/preface002.xhtml#../Images/Art_P3.jpg", "src": "assets/english/volume-1/Art_P3.webp", "width": 1800, "height": 1348}]}
