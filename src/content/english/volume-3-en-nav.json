{"blocks": [{"id": "en-nav-0", "kind": "heading", "text": "Contents", "source": "OEBPS/Text/nav.xhtml#0", "headingLevel": 2}, {"id": "en-nav-1", "kind": "text", "text": "Cover", "source": "OEBPS/Text/nav.xhtml#1"}, {"id": "en-nav-2", "kind": "text", "text": "Insert", "source": "OEBPS/Text/nav.xhtml#2"}, {"id": "en-nav-3", "kind": "text", "text": "Title Page", "source": "OEBPS/Text/nav.xhtml#3"}, {"id": "en-nav-4", "kind": "text", "text": "Copyright", "source": "OEBPS/Text/nav.xhtml#4"}, {"id": "en-nav-5", "kind": "text", "text": "Cast of Characters", "source": "OEBPS/Text/nav.xhtml#5"}, {"id": "en-nav-6", "kind": "text", "text": "1 This is how Shizuka Hiratsuka kicks off a new competition.", "source": "OEBPS/Text/nav.xhtml#6"}, {"id": "en-nav-7", "kind": "text", "text": "2 Saika Totsuka’s youth romantic comedy is right, as I expected.", "source": "OEBPS/Text/nav.xhtml#7"}, {"id": "en-nav-8", "kind": "text", "text": "3 Yukino Yukinoshita really does love cats.", "source": "OEBPS/Text/nav.xhtml#8"}, {"id": "en-nav-9", "kind": "text", "text": "4 Komachi Hikigaya is shrewdly scheming.", "source": "OEBPS/Text/nav.xhtml#9"}, {"id": "en-nav-10", "kind": "text", "text": "5 Despite it all, Yoshiteru Zaimokuza wails alone in the wasteland.", "source": "OEBPS/Text/nav.xhtml#10"}, {"id": "en-nav-11", "kind": "text", "text": "6 Finally, his and her beginning ends.", "source": "OEBPS/Text/nav.xhtml#11"}, {"id": "en-nav-12", "kind": "text", "text": "BT Bonus track! “Like, This Sort of Birthday Song.”", "source": "OEBPS/Text/nav.xhtml#12"}, {"id": "en-nav-13", "kind": "text", "text": "Translation Notes", "source": "OEBPS/Text/nav.xhtml#13"}, {"id": "en-nav-14", "kind": "text", "text": "Yen Newsletter", "source": "OEBPS/Text/nav.xhtml#14"}, {"id": "en-nav-15", "kind": "heading", "text": "Navigation", "source": "OEBPS/Text/nav.xhtml#15", "headingLevel": 2}, {"id": "en-nav-16", "kind": "text", "text": "Begin Reading", "source": "OEBPS/Text/nav.xhtml#16"}, {"id": "en-nav-17", "kind": "