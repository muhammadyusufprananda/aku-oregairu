opyright.xhtml#30"}, {"id": "en-copyright-31", "kind": "text", "text": "ISBN: 978-1-9753-5986-7", "source": "OEBPS/Text/copyright.xhtml#31"}, {"id": "en-copyright-32", "kind": "text", "text": "E3-20190607-JV-NF-ORI", "source": "OEBPS/Text/copyright.xhtml#32"}, {"id": "en-toc-0", "kind": "heading", "text": "Contents", "source": "OEBPS/Text/toc.xhtml#0", "headingLevel": 2}, {"id": "en-toc-1", "kind": "text", "text": "Cover", "source": "OEBPS/Text/toc.xhtml#1"}, {"id": "en-toc-2", "kind": "text", "text": "Insert", "source": "OEBPS/Text/toc.xhtml#2"}, {"id": "en-toc-3", "kind": "text", "text": "Title Page", "source": "OEBPS/Text/toc.xhtml#3"}, {"id": "en-toc-4", "kind": "text", "text": "Copyright", "source": "OEBPS/Text/toc.xhtml#4"}, {"id": "en-toc-5", "kind": "text", "text": "Cast of Characters", "source": "OEBPS/Text/toc.xhtml#5"}, {"id": "en-toc-6", "kind": "text", "text": "1 Hachiman Hikigaya’s life at school is, in fact, extremely peaceful.", "source": "OEBPS/Text/toc.xhtml#6", "emphasis": [{"start": 2, "end": 19, "style": "strong"}]}, {"id": "en-toc-7", "kind": "text", "text": "2 Nobody knows why they came to the Service Club.", "source": "OEBPS/Text/toc.xhtml#7", "emphasis": [{"start": 19, "end": 23, "style": "strong"}]}, {"id": "en-toc-8", "kind": "text", "text": "3 Kakeru Tobe is just hopelessly shallow.", "source": "OEBPS/Text/toc.xhtml#8", "emphasis": [{"start": 2, "end": 13, "style": "strong"}]}, {"id": "en-toc-9", "kind": "text", "text": "4 At the end of the day, Hina Ebina is rotten?", "source": "OEBPS/Text/toc.xhtml#9", "emphasis": [{"start": 25, "end": 35, "style": "strong"}]}, {"id": "en-toc-10", "kind": "text", "text": "5 As you can see, Yui Yuigahama is doing her best.", "source": "OEBPS/Text/toc.xhtml#10", "emphasis": [{"start": 18, "end": 31, "style": "strong"}]}, {"id": "en-toc-11", "kind": "text", "text": "6 Surreptitiously, Yukino Yukinoshita goes out to town at night.", "source": "OEBPS/Text/toc.xhtml#11", "emphasis": [{"start": 19, "end": 37, "style": "strong"}]}, {"id": "en-toc-12", "kind": "text", "text": "7 Unexpectedly, Yumiko Miura is actually paying attention.", "source": "OEBPS/Text/toc.xhtml#12", "emphasis": [{"start": 16, "end": 28, "style": "strong"}]}, {"id": "en-toc-13", "kind": "text", "text": "8 Even so, Hayato Hayama can’t make a choice.", "source": "OEBPS/Text/toc.xhtml#13", "emphasis": [{"start": 11, "end": 24, "style": "strong"}]}, {"id": "en-toc-14", "kind": "text", "text": "9 His and her confessions will reach no one.", "source": "OEBPS/Text/toc.xhtml#14", "emphasis": [{"start": 2, "end": 13, "style": "strong"}]}, {"id": "en-toc-15", "kind": "text", "text": "BT Bonus track! The girls will rock you. ", "source": "OEBPS/Text/toc.xhtml#15", "emphasis": [{"start": 20, "end": 25, "style": "strong"}]}, {"id": "en-toc-16", "kind": "image", "text": "image", "source": "OEBPS/Text/toc.xhtml#../Images/Art_heart.jpg", "src": "assets/english/volume-7/Art_heart.webp", "width": 38, "height": 43}, {"id": "en-toc-17", "kind": "text", "text": "Afterword", "source": "OEBPS/Text/toc.xhtml#17"}, {"id": "en-toc-18", "kind": "text", "text": "Translation Notes", "source": "OEBPS/Text/toc.xhtml#18"}, {"id": "en-toc-19", "kind": "text", "text": "Yen Newsletter", "source": "OEBPS/Text/toc.xhtml#19"}, {"id": "en-characters-0", "kind": "image", "text": "Book Title Page", "source": "OEBPS/Text/characters.xhtml#../Images/Art_char.jpg", "src": "assets/english/volume-7/Art_char.webp", "width": 1200, "height": 1800}, {"id": "en-characters_a-0", "kind": "image", "text": "Book Title Page", "source": "OEBPS/Text/characters_a.xhtml#../Images/Art_P3.jpg", "src": "assets/english/volume-7/Art_P3.webp", "width": 1200, "height": 1800}]}
