---
import "../styles/global.css";
import "@fontsource/literata/latin-400.css";
import "@fontsource/nunito/latin-900.css";
import "@fontsource/noto-sans/latin-400.css";
import "@fontsource/noto-sans/latin-400-italic.css";
import "@fontsource/noto-sans/latin-700.css";
import "@fontsource/noto-sans/latin-700-italic.css";
import "@fontsource/literata/latin-700.css";
import "@fontsource/literata/latin-700-italic.css";
import "@fontsource/literata/latin-500.css";
import "@fontsource/literata/latin-400-italic.css";
import { url } from "../lib/catalog";
interface Props {
  title: string;
  reader?: boolean;
}
const { title, reader = false } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Proyek independen Aku Oregairu. Pengalaman membaca yang tenang, dirancang untuk ponsel."
    />
    <title>{title} · Aku Oregairu</title>
    <link rel="manifest" href={url("manifest.webmanifest")} />
    <link rel="icon" href={url("favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" href={url("icons/favicon-32.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("icons/icon-180.png")} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-title" content="Aku Oregairu" />
  </head>
  <body class:list={[reader && "reader-body"]}>
    {!reader && (
      <header class="site-header">
        <a class="wordmark" href={url()}>
          Aku Oregairu
          <small>Proyek terjemahan penggemar independen</small>
        </a>
        <a class="about-link" href={url("tentang/")}>
          Tentang <span aria-hidden="true">↗</span>
        </a>
      </header>
    )}
    <slot />
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base })
            .catch(() => { /* Situs tetap dapat dibaca jika cache tidak tersedia. */ });
        });
      }
    </script>
    {!reader && (
      <footer class="site-footer">
        <span>Aku Oregairu</span>
        <span>Ruang kecil untuk cerita yang panjang.</span>
        <a href={url("tentang/")}>Tentang proyek</a>
      </footer>
    )}
  </body>
</html>
