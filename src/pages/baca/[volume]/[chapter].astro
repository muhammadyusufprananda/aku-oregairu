---
import Base from "../../../layouts/Base.astro";
import ReaderBlock from "../../../components/ReaderBlock.astro";
import {
  chapters,
  chaptersFor,
  chapterUrl,
  editorialLabel,
  url,
} from "../../../lib/catalog";
import { blocksFor } from "../../../lib/content";
export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { volume: chapter.volume, chapter: chapter.slug },
    props: { chapter },
  }));
}
const { chapter } = Astro.props;
const blocks = blocksFor(chapter);
const volumeChapters = chaptersFor(chapter.volume);
const nextChapter = volumeChapters.find((c) => c.number > chapter.number);
---

<Base title={chapter.title} reader>
  <noscript>
    <style>
      .reader [data-open],
      .reader #prev,
      .reader #next {
        display: none;
      }
      .reader-bottom {
        justify-content: center;
      }
    </style>
  </noscript>
  <main
    class="reader fallback"
    id="reader"
    data-volume={chapter.volume}
    data-chapter={chapter.slug}
    data-font="sans"
    data-theme="putih"
  >
    <header class="reader-top">
      <a
        class="icon-button"
        href={url(`volume/${chapter.volume}/`)}
        aria-label="Kembali ke daftar bab"
      >
        ←
      </a>
      <span>
        Volume 01 · Bab {chapter.number}
        <br />
        {chapter.title}
      </span>
      <button
        class="icon-button"
        data-open="settings"
        aria-label="Pengaturan baca"
      >
        Aa
      </button>
      <button class="icon-button" data-open="toc" aria-label="Daftar bab">
        ☰
      </button>
    </header>
    <aside class="reader-editorial" aria-label="Status editorial">
      {editorialLabel(chapter)}
    </aside>
    <article class="page-area" id="page" aria-label="Halaman bacaan">
      {blocks.map((block) => (
        <ReaderBlock block={block} />
      ))}
    </article>
    <footer class="reader-bottom">
      <button id="prev" class="icon-button" aria-label="Halaman sebelumnya">
        ←
      </button>
      <div class="reader-progress">
        <a
          id="next-chapter"
          href={
            nextChapter
              ? chapterUrl(nextChapter)
              : url(`volume/${chapter.volume}/`)
          }
          hidden
        >
          {nextChapter ? "Bab berikutnya →" : "Kembali ke daftar bab →"}
        </a>
        <span id="page-count" aria-live="polite">
          Mode baca bergulir
        </span>
      </div>
      <button id="next" class="icon-button" aria-label="Halaman berikutnya">
        →
      </button>
    </footer>
    <dialog id="settings">
      <div class="dialog-heading">
        <h2>Pengaturan baca</h2>
        <button class="icon-button" data-close aria-label="Tutup pengaturan">
          ×
        </button>
      </div>
      <label class="setting">
        Ukuran font <output id="size-output">18 px</output>
        <input
          id="font-size"
          type="range"
          min="16"
          max="28"
          step="1"
          value="18"
        />
      </label>
      <div class="setting">
        Jenis font
        <div class="choices">
          {[
            { value: "sans", label: "Sans-serif" },
            { value: "serif", label: "Serif" },
          ].map((f) => (
            <button data-font-value={f.value} aria-pressed={f.value === "sans"}>
              {f.label}
            </button>
          ))}
        </div>
      </div>
      <div class="setting">
        Tema tampilan
        <div class="choices" id="themes">
          {["Kertas", "Putih", "Gelap"].map((t) => (
            <button
              data-theme-value={t.toLowerCase()}
              aria-pressed={t === "Putih"}
            >
              {t}
            </button>
          ))}
        </div>
      </div>
      <div class="setting">
        Spasi baris
        <div class="choices" id="leading">
          {[1.5, 1.8, 2].map((n) => (
            <button data-leading={n} aria-pressed={n === 1.8}>
              {n.toFixed(1)}×
            </button>
          ))}
        </div>
      </div>
      <p class="muted" style="font-size:12px">
        Posisi membaca dan pengaturan disimpan otomatis di browser ini jika
        penyimpanan tersedia.
      </p>
    </dialog>
    <dialog id="toc">
      <div class="dialog-heading">
        <h2>Daftar bab</h2>
        <button class="icon-button" data-close aria-label="Tutup daftar bab">
          ×
        </button>
      </div>
      {volumeChapters.map((c) => (
        <a
          href={chapterUrl(c)}
          aria-current={c.id === chapter.id ? "page" : undefined}
        >
          {String(c.number).padStart(2, "0")} · {c.title}
        </a>
      ))}
    </dialog>
    <dialog id="viewer" class="viewer">
      <div class="dialog-heading">
        <span>Ilustrasi Volume 01 · Bab {chapter.number}</span>
        <button data-close class="icon-button" aria-label="Tutup ilustrasi">
          ×
        </button>
      </div>
      <div class="viewer-stage">
        <img id="viewer-image" alt="" draggable="false" />
      </div>
      <div class="viewer-tools">
        <button class="icon-button" id="zoom-out" aria-label="Perkecil">
          −
        </button>
        <button
          class="icon-button"
          id="zoom-reset"
          aria-label="Atur ulang zoom"
        >
          100%
        </button>
        <button class="icon-button" id="zoom-in" aria-label="Perbesar">
          +
        </button>
      </div>
    </dialog>
    <script
      id="chapter-data"
      type="application/json"
      set:html={JSON.stringify(blocks).replace(/</g, "\u003c")}
    />
  </main>
</Base>
<script>
  import "../../../lib/reader";
</script>
