---
import Base from "../layouts/Base.astro";
import VolumeCover from "../components/VolumeCover.astro";
import { volumes, url, chaptersFor } from "../lib/catalog";
---

<Base title="Koleksi volume">
  <main class="catalog">
    <section class="series-hero" aria-label="Oregairu">
      <img
        class="hero-art"
        src={url("assets/yukino-800.webp")}
        srcset={`${url("assets/yukino-400.webp")} 400w, ${url("assets/yukino-800.webp")} 800w`}
        sizes="(max-width:480px) 76vw, 420px"
        width="800"
        height="1200"
        alt="Ilustrasi Yukino Yukinoshita di dekat jendela"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <p class="hero-title">
          My Youth
          <br />
          Romantic
          <br />
          Comedy Is
          <br />
          Wrong, As
          <br />I Expected
        </p>
        <p class="hero-subtitle">
          Yahari Ore no Seishun Love Comedy wa Machigatteiru
        </p>
        <dl class="hero-credits">
          <div>
            <dt>Penulis</dt>
            <dd>Wataru Watari</dd>
          </div>
          <div>
            <dt>Ilustrator</dt>
            <dd>Ponkan8</dd>
          </div>
        </dl>
      </div>
    </section>
    <div class="section-heading">
      <h1>Koleksi volume</h1>
      <span>Oregairu</span>
    </div>
    <a id="resume" class="resume" hidden>
      Lanjutkan membaca <span>→</span>
    </a>
    <div class="volume-grid">
      {volumes.map((v, index) => (
        <article class="volume-card">
          <a href={url(`volume/${v.slug}/`)}>
            <VolumeCover {...v} eager={index < 4} />
            <h2>Volume {v.number}</h2>
            <p>
              {chaptersFor(v.slug).length
                ? `Bab 1 tersedia · ${chaptersFor(v.slug)[0].editorialStatus === "draft" ? "Draf" : "Sudah ditinjau"}`
                : "Konten belum tersedia"}
            </p>
          </a>
        </article>
      ))}
    </div>
  </main>
</Base>
<script>
  import { readProgress } from "../lib/storage";
  import { getChapter, chapterUrl } from "../lib/catalog";
  const progress = readProgress();
  const chapter = progress
    ? getChapter(progress.volume, progress.chapter)
    : undefined;
  const resume = document.querySelector<HTMLAnchorElement>("#resume");
  if (chapter && resume) {
    resume.href = chapterUrl(chapter);
    resume.hidden = false;
    resume.firstChild!.textContent = `Lanjutkan Membaca · Volume 01 Bab ${chapter.number} `;
  }
</script>
