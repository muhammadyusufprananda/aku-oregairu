---
import Base from "../layouts/Base.astro";
import VolumeCover from "../components/VolumeCover.astro";
import { volumes, url } from "../lib/catalog";
---

<Base title="Koleksi volume">
  <main class="catalog">
    <section class="series-hero" aria-label="Oregairu">
      <img
        class="hero-art"
        src={url("assets/yukino-800.webp")}
        srcset={`${url("assets/yukino-400.webp")} 400w, ${url("assets/yukino-800.webp")} 800w`}
        sizes="(max-width:480px) 76vw, 420px"
        width="800"
        height="1200"
        alt="Ilustrasi Yukino Yukinoshita di dekat jendela"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <p class="hero-title">
          My Youth
          <br />
          Romantic
          <br />
          Comedy Is
          <br />
          Wrong, As
          <br />I Expected
        </p>
        <p class="hero-subtitle">
          Yahari Ore no Seishun Love Comedy wa Machigatteiru
        </p>
      </div>
    </section>
    <div class="section-heading">
      <h1>Koleksi volume</h1>
      <span>Oregairu</span>
    </div>
    <a id="resume" class="resume" hidden>
      Lanjutkan membaca <span>→</span>
    </a>
    <div class="volume-grid">
      {volumes.map((v, index) => (
        <article class="volume-card">
          <a href={url(`volume/${v.slug}/`)}>
            <VolumeCover {...v} eager={index < 4} />
            <h2>Volume {v.number}</h2>
            <p>Konten belum tersedia</p>
          </a>
        </article>
      ))}
    </div>
    <section class="demo-banner" aria-label="Contoh pembaca">
      <div>
        <h2>Contoh Baca Orisinal</h2>
        <p>Teks demo, bukan terjemahan Oregairu.</p>
      </div>
      <a class="text-link" href={url("volume/contoh/")}>
        Coba <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Base>
<script>
  import { readProgress } from "../lib/storage";
  import { chapters, url } from "../lib/catalog";
  const progress = readProgress();
  const resume = document.querySelector<HTMLAnchorElement>("#resume");
  if (progress && resume) {
    resume.href = url(`baca/contoh/${chapters[progress.chapter].slug}/`);
    resume.hidden = false;
    resume.firstChild!.textContent = `Lanjutkan contoh · ${chapters[progress.chapter].title} `;
  }
</script>
