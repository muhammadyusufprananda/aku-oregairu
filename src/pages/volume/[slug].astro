---
import Base from "../../layouts/Base.astro";
import VolumeCover from "../../components/VolumeCover.astro";
import {
  volumes,
  chaptersFor,
  chapterUrl,
  editorialLabel,
  url,
} from "../../lib/catalog";
export function getStaticPaths() {
  return volumes.map((volume) => ({
    params: { slug: volume.slug },
    props: { volume },
  }));
}
const { volume } = Astro.props;
const chapters = chaptersFor(volume.slug);
---

<Base title={`Volume ${volume.number}`}>
  <main class="detail">
    <a class="back" href={url()}>
      ← Kembali ke koleksi
    </a>
    <section class="detail-intro">
      <VolumeCover {...volume} eager />
      <div>
        <span class="eyebrow">Koleksi Oregairu</span>
        <h1>Volume {volume.number}</h1>
        <p class="description">
          {chapters.length
            ? "Bab 1 tersedia dalam bahasa Indonesia, diterjemahkan dari edisi berbahasa Inggris. Baca label editorial sebelum mulai."
            : "Teks terjemahan belum tersedia untuk volume ini."}
        </p>
        {chapters.length > 0 && (
          <a
            class="primary"
            id="start-reading"
            data-volume={volume.slug}
            href={chapterUrl(chapters[0])}
          >
            Mulai Membaca →
          </a>
        )}
      </div>
    </section>
    {chapters.length ? (
      <section>
        <h2>Daftar bab</h2>
        <ol class="chapter-list">
          {chapters.map((c) => (
            <li>
              <a href={chapterUrl(c)}>
                <small>{String(c.number).padStart(2, "0")}</small>
                <span>
                  {c.title}
                  <small class="chapter-status">{editorialLabel(c)}</small>
                </span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="notice">
          {editorialLabel(chapters[0])}.{" "}
          {chapters[0].editorialStatus === "draft"
            ? "Terjemahan ini memerlukan peninjauan manusia untuk ketepatan makna, istilah, dan gaya bahasa."
            : "Peninjauan manusia telah dikonfirmasi oleh pemilik proyek."}
        </p>
      </section>
    ) : (
      <p class="notice">Konten belum tersedia.</p>
    )}
  </main>
</Base>
<script>
  import { readProgress } from "../../lib/storage";
  import { getChapter, chapterUrl } from "../../lib/catalog";
  const p = readProgress(),
    a = document.querySelector<HTMLAnchorElement>("#start-reading");
  const c = p ? getChapter(p.volume, p.chapter) : undefined;
  if (c && a && c.volume === a.dataset.volume) {
    a.href = chapterUrl(c);
    a.textContent = "Lanjutkan Membaca →";
  }
</script>
