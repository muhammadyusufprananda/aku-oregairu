---
import Base from "../../layouts/Base.astro";
import VolumeCover from "../../components/VolumeCover.astro";
import {
  volumes,
  sectionsFor,
  sectionUrl,
  editorialLabel,
  url,
} from "../../lib/catalog";
export function getStaticPaths() {
  return volumes.map((volume) => ({
    params: { slug: volume.slug },
    props: { volume },
  }));
}
const { volume } = Astro.props;
const chapters = sectionsFor(volume.slug);
---

<Base title={`Volume ${volume.number}`}>
  <main class="detail">
    <a class="back" href={url()}>
      ← Kembali ke koleksi
    </a>
    <section class="detail-intro">
      <VolumeCover {...volume} eager />
      <div>
        <span class="eyebrow">Koleksi Oregairu</span>
        <h1>Volume {volume.number}</h1>
        <p class="description">
          {chapters.length
            ? "Pembuka, Bab 1–8, kata penutup, dan catatan penerjemah tersedia sebagai draf. Terjemahan disusun dari edisi Inggris; perhatikan status editorial setiap bagian."
            : "Teks terjemahan belum tersedia untuk volume ini."}
        </p>
        {chapters.length > 0 && (
          <a
            class="primary"
            id="start-reading"
            data-volume={volume.slug}
            href={sectionUrl(chapters[0])}
          >
            Mulai Membaca →
          </a>
        )}
      </div>
    </section>
    {chapters.length ? (
      <section>
        <h2>Daftar bab</h2>
        <ol class="chapter-list">
          {chapters.map((c) => (
            <li>
              <a href={sectionUrl(c)}>
                <small>
                  {c.kind === "frontmatter"
                    ? "Awal"
                    : c.kind === "backmatter"
                      ? "Akhir"
                      : String(c.number).padStart(2, "0")}
                </small>
                <span>
                  {c.title}
                  <small class="chapter-status">{editorialLabel(c)}</small>
                </span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="notice">
          Setiap bagian memiliki status editorial sendiri. Label “Draf”
          menandakan terjemahan berbantuan AI yang belum ditinjau manusia untuk
          ketepatan makna, istilah, dan gaya bahasa.
        </p>
      </section>
    ) : (
      <p class="notice">Konten belum tersedia.</p>
    )}
  </main>
</Base>
<script>
  import { readProgress } from "../../lib/storage";
  import { getSection, sectionUrl } from "../../lib/catalog";
  const p = readProgress(),
    a = document.querySelector<HTMLAnchorElement>("#start-reading");
  const c = p ? getSection(p.volume, p.chapter) : undefined;
  if (c && a && c.volume === a.dataset.volume) {
    a.href = sectionUrl(c);
    a.textContent = "Lanjutkan Membaca →";
  }
</script>
